rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
    }
  }
}
